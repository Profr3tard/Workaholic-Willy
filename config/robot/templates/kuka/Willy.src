&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF Willy()
;========================================================================
;  Willy.src --- KRL program implementing the Willy EKI protocol.
;
;  Drop this program plus EkiHwInterface.xml into the controller. Start
;  Willy() from a SubmitInterpreter or the smartHMI manual run.
;
;  The PC-side wire protocol lives in:
;     src/robot/drivers/kuka/protocol.py
;  Tags supported here:
;     Inbound (Willy -> KRL):
;        <Cmd Type="Willy"><Move Mode="PTP|LIN" X=.. Y=.. Z=.. A=.. B=.. C=..
;                                  Vel=.. Acc=../></Cmd>
;        <Cmd ...><MoveJ J1=.. ... J6=.. Vel=.. Acc=../></Cmd>
;        <Cmd ...><Stop/></Cmd>
;        <Cmd ...><Home/></Cmd>
;        <Cmd ...><FkRequest Id=.. J1=.. ... J6=../></Cmd>
;        <Cmd ...><IkRequest Id=.. X=.. ... C=.. S1=.. ... S6=../></Cmd>
;        <Cmd ...><Echo Token=../></Cmd>
;     Outbound (KRL -> Willy):
;        <Sen Type="Willy"><State X=.. Y=.. Z=.. A=.. B=.. C=..
;                                   J1=.. ... J6=.. Steady="0|1"/></Sen>
;        <Sen ...><Ack Cmd=".." Status="ok|error" Detail=".."/></Sen>
;        <Sen ...><FkResult Id=.. X=.. ... C=.. Status=".."/></Sen>
;        <Sen ...><IkResult Id=.. J1=.. ... J6=.. Status=".."/></Sen>
;        <Sen ...><EchoAck Token=".."/></Sen>
;
;  IMPLEMENTATION NOTES
;  --------------------
;  * Every <Sen ...> frame MUST be followed by a single '\n' byte. Use
;    EKI_Send(handle, "Sen", payload + Chr(10)).
;  * State frames are emitted at ~50 Hz from a side-loop. The "Steady"
;    flag is derived from $IN_HOME == FALSE / motion-buffer empty.
;  * FK / IK reuse the controller's $POS_FOR / INVERSE() utilities.
;  * Implement the move-rate mapping (Vel% / Acc%) however your safety
;    case requires --- the example below maps to $VEL.CP and $ACC.CP.
;
;  This file is a TEMPLATE: the procedures below are intentionally
;  short on KRL detail so integrators can adapt them to site-specific
;  safety conventions (RoboTeam, SafeOperation, etc.).
;========================================================================

INI

; --- 1. Open the EKI channel (matches EkiHwInterface.xml).
EKI_Init("Willy")
EKI_Open("Willy")

; --- 2. Spawn the periodic State publisher (typically a SUBMIT job).
;        Pseudocode --- replace with your site's task hookup:
;            SubmitTask("WillyTelemetry")
;
; --- 3. Main command-handling loop. Pull the next <Cmd> from $EKI_CMD
;        and dispatch.
LOOP
   IF $FLAG[990] THEN              ; <Move ... />
      $FLAG[990] = FALSE
      WillyHandleMove()
   ENDIF
   IF $FLAG[991] THEN              ; <MoveJ ... />
      $FLAG[991] = FALSE
      WillyHandleMoveJ()
   ENDIF
   IF $FLAG[992] THEN              ; <Stop/>
      $FLAG[992] = FALSE
      BRAKE                        ; halt motion immediately
      WillySendAck("Stop", "ok", "")
   ENDIF
   IF $FLAG[993] THEN              ; <Home/>
      $FLAG[993] = FALSE
      PTP WILLY_HOME
      WillySendAck("Home", "ok", "")
   ENDIF
   IF $FLAG[994] THEN              ; <FkRequest .../>
      $FLAG[994] = FALSE
      WillyHandleFk()
   ENDIF
   IF $FLAG[995] THEN              ; <IkRequest .../>
      $FLAG[995] = FALSE
      WillyHandleIk()
   ENDIF
   IF $FLAG[996] THEN              ; <Echo Token=".."/>
      $FLAG[996] = FALSE
      WillyEchoAck()
   ENDIF
   WAIT SEC 0.005
ENDLOOP

EKI_Close("Willy")
END

;------------------------------------------------------------------------
; Cartesian move (PTP or LIN)
;------------------------------------------------------------------------
DEF WillyHandleMove()
   ; Extract attributes from the parsed Cmd/Move element.
   WILLY_TARGET.X = EKI_GetReal("Willy", "Cmd/Move/@X")
   WILLY_TARGET.Y = EKI_GetReal("Willy", "Cmd/Move/@Y")
   WILLY_TARGET.Z = EKI_GetReal("Willy", "Cmd/Move/@Z")
   WILLY_TARGET.A = EKI_GetReal("Willy", "Cmd/Move/@A")
   WILLY_TARGET.B = EKI_GetReal("Willy", "Cmd/Move/@B")
   WILLY_TARGET.C = EKI_GetReal("Willy", "Cmd/Move/@C")

   ; --- Dispatch on Mode attribute.
   IF EKI_GetString("Willy", "Cmd/Move/@Mode") == "LIN" THEN
      LIN WILLY_TARGET WITH $BASE = BASE_DATA[WILLY_BASE_NO], $TOOL = TOOL_DATA[WILLY_TOOL_NO]
   ELSE
      PTP WILLY_TARGET WITH $BASE = BASE_DATA[WILLY_BASE_NO], $TOOL = TOOL_DATA[WILLY_TOOL_NO]
   ENDIF
   WillySendAck("Move", "ok", "")
END

;------------------------------------------------------------------------
; Joint-space move
;------------------------------------------------------------------------
DEF WillyHandleMoveJ()
   WILLY_J_TARGET.A1 = EKI_GetReal("Willy", "Cmd/MoveJ/@J1")
   WILLY_J_TARGET.A2 = EKI_GetReal("Willy", "Cmd/MoveJ/@J2")
   WILLY_J_TARGET.A3 = EKI_GetReal("Willy", "Cmd/MoveJ/@J3")
   WILLY_J_TARGET.A4 = EKI_GetReal("Willy", "Cmd/MoveJ/@J4")
   WILLY_J_TARGET.A5 = EKI_GetReal("Willy", "Cmd/MoveJ/@J5")
   WILLY_J_TARGET.A6 = EKI_GetReal("Willy", "Cmd/MoveJ/@J6")
   PTP WILLY_J_TARGET
   WillySendAck("MoveJ", "ok", "")
END

;------------------------------------------------------------------------
; FK request: round-trip $POS_FOR(seed) back to Willy.
;------------------------------------------------------------------------
DEF WillyHandleFk()
   DECL E6POS  fk_result
   WILLY_REQ_ID[] = EKI_GetString("Willy", "Cmd/FkRequest/@Id")
   WILLY_J_SEED.A1 = EKI_GetReal("Willy", "Cmd/FkRequest/@J1")
   WILLY_J_SEED.A2 = EKI_GetReal("Willy", "Cmd/FkRequest/@J2")
   WILLY_J_SEED.A3 = EKI_GetReal("Willy", "Cmd/FkRequest/@J3")
   WILLY_J_SEED.A4 = EKI_GetReal("Willy", "Cmd/FkRequest/@J4")
   WILLY_J_SEED.A5 = EKI_GetReal("Willy", "Cmd/FkRequest/@J5")
   WILLY_J_SEED.A6 = EKI_GetReal("Willy", "Cmd/FkRequest/@J6")
   fk_result = $POS_FOR(WILLY_J_SEED, BASE_DATA[WILLY_BASE_NO], TOOL_DATA[WILLY_TOOL_NO])
   WillySendFkResult(WILLY_REQ_ID[], fk_result)
END

;------------------------------------------------------------------------
; IK request: use INVERSE() and reply with the joint solution.
;------------------------------------------------------------------------
DEF WillyHandleIk()
   DECL E6AXIS ik_result
   DECL INT    ik_status
   WILLY_REQ_ID[] = EKI_GetString("Willy", "Cmd/IkRequest/@Id")
   WILLY_TARGET.X = EKI_GetReal("Willy", "Cmd/IkRequest/@X")
   WILLY_TARGET.Y = EKI_GetReal("Willy", "Cmd/IkRequest/@Y")
   WILLY_TARGET.Z = EKI_GetReal("Willy", "Cmd/IkRequest/@Z")
   WILLY_TARGET.A = EKI_GetReal("Willy", "Cmd/IkRequest/@A")
   WILLY_TARGET.B = EKI_GetReal("Willy", "Cmd/IkRequest/@B")
   WILLY_TARGET.C = EKI_GetReal("Willy", "Cmd/IkRequest/@C")
   WILLY_J_SEED.A1 = EKI_GetReal("Willy", "Cmd/IkRequest/@S1")
   WILLY_J_SEED.A2 = EKI_GetReal("Willy", "Cmd/IkRequest/@S2")
   WILLY_J_SEED.A3 = EKI_GetReal("Willy", "Cmd/IkRequest/@S3")
   WILLY_J_SEED.A4 = EKI_GetReal("Willy", "Cmd/IkRequest/@S4")
   WILLY_J_SEED.A5 = EKI_GetReal("Willy", "Cmd/IkRequest/@S5")
   WILLY_J_SEED.A6 = EKI_GetReal("Willy", "Cmd/IkRequest/@S6")
   ik_result = INVERSE(WILLY_TARGET, WILLY_J_SEED, ik_status, BASE_DATA[WILLY_BASE_NO], TOOL_DATA[WILLY_TOOL_NO])
   IF ik_status == 0 THEN
      WillySendIkResult(WILLY_REQ_ID[], ik_result, "ok", "")
   ELSE
      WillySendIkResult(WILLY_REQ_ID[], ik_result, "error", "INVERSE() returned status=" + IntToStr(ik_status))
   ENDIF
END

;------------------------------------------------------------------------
; Echo: bounce the token back as <EchoAck>.
;------------------------------------------------------------------------
DEF WillyEchoAck()
   DECL CHAR token[64]
   token[] = EKI_GetString("Willy", "Cmd/Echo/@Token")
   EKI_Send("Willy", "<Sen Type='Willy'><EchoAck Token='" + token[] + "'/></Sen>" + Chr(10))
END

;------------------------------------------------------------------------
; Helper sends. Each MUST end with '\n' for Willy's framer to find it.
;------------------------------------------------------------------------
DEF WillySendAck(cmd: IN, status: IN, detail: IN)
   DECL CHAR cmd[32], status[16], detail[160]
   EKI_Send("Willy",
      "<Sen Type='Willy'><Ack Cmd='" + cmd[] + "' Status='" + status[]
        + "' Detail='" + detail[] + "'/></Sen>" + Chr(10))
END

DEF WillySendFkResult(req_id: IN, p: IN)
   DECL CHAR req_id[64]
   DECL E6POS p
   EKI_Send("Willy",
      "<Sen Type='Willy'><FkResult Id='" + req_id[] + "'"
        + " X='" + RealToStr(p.X) + "' Y='" + RealToStr(p.Y) + "' Z='" + RealToStr(p.Z) + "'"
        + " A='" + RealToStr(p.A) + "' B='" + RealToStr(p.B) + "' C='" + RealToStr(p.C) + "'"
        + " Status='ok'/></Sen>" + Chr(10))
END

DEF WillySendIkResult(req_id: IN, j: IN, status: IN, detail: IN)
   DECL CHAR req_id[64], status[16], detail[160]
   DECL E6AXIS j
   EKI_Send("Willy",
      "<Sen Type='Willy'><IkResult Id='" + req_id[] + "'"
        + " J1='" + RealToStr(j.A1) + "' J2='" + RealToStr(j.A2) + "' J3='" + RealToStr(j.A3) + "'"
        + " J4='" + RealToStr(j.A4) + "' J5='" + RealToStr(j.A5) + "' J6='" + RealToStr(j.A6) + "'"
        + " Status='" + status[] + "' Detail='" + detail[] + "'/></Sen>" + Chr(10))
END

;------------------------------------------------------------------------
; Telemetry publisher (run from a SUBMIT task at ~20-50 Hz).
;------------------------------------------------------------------------
DEF WillySendState()
   DECL E6POS  cur_pos
   DECL E6AXIS cur_axis
   DECL CHAR   steady[2]
   cur_pos  = $POS_ACT
   cur_axis = $AXIS_ACT
   IF $IN_HOME THEN
      steady[] = "1"
   ELSE
      steady[] = "0"
   ENDIF
   EKI_Send("Willy",
      "<Sen Type='Willy'><State"
        + " X='" + RealToStr(cur_pos.X) + "' Y='" + RealToStr(cur_pos.Y) + "' Z='" + RealToStr(cur_pos.Z) + "'"
        + " A='" + RealToStr(cur_pos.A) + "' B='" + RealToStr(cur_pos.B) + "' C='" + RealToStr(cur_pos.C) + "'"
        + " J1='" + RealToStr(cur_axis.A1) + "' J2='" + RealToStr(cur_axis.A2) + "' J3='" + RealToStr(cur_axis.A3) + "'"
        + " J4='" + RealToStr(cur_axis.A4) + "' J5='" + RealToStr(cur_axis.A5) + "' J6='" + RealToStr(cur_axis.A6) + "'"
        + " Steady='" + steady[] + "'/></Sen>" + Chr(10))
END
