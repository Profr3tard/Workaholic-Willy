<!--
  EthernetKRL hardware interface --- Willy ↔ KUKA controller
  ===========================================================

  Drop this file into the controller at:
      KRC:\R1\TP\EthernetKRL\Willy\EkiHwInterface.xml

  This config wires up a single bidirectional TCP/XML channel that
  matches the wire protocol implemented in
  backend/src/robot/drivers/kuka/protocol.py.

  Key conventions
  ---------------
  * Willy is the **TCP server** by default (role="server" in
    KukaEkiConfig). The KRL program OPENS the channel and dials in.
  * Frames are newline-terminated; the controller's send routine MUST
    append `\n` after each XML element.
  * Outbound (KRL → Willy) root tag is <Sen Type="Willy">.
  * Inbound  (Willy → KRL) root tag is <Cmd Type="Willy">.

  Replace ${WILLY_HOST} / ${WILLY_PORT} with the actual values used
  in your deployment. The defaults match KukaEkiConfig defaults.
-->
<ETHERNETKRLXML>
  <CONFIGURATION>
    <EXTERNAL>
      <TYPE>Client</TYPE>                      <!-- KRL is the TCP client -->
      <IP>${WILLY_HOST}</IP>
      <PORT>${WILLY_PORT}</PORT>
    </EXTERNAL>
    <INTERNAL>
      <BUFFERING Limit="32" />
      <BUFFSIZE>4096</BUFFSIZE>
      <ALIVE Set_Flag="998" />
    </INTERNAL>
  </CONFIGURATION>

  <!--
    Receive (Willy → KRL):
      Willy frames every command in <Cmd Type="Willy"><...></Cmd>.
      Map every supported child tag here so EKI parses straight into
      $EKI_CMD on the KRL side.
  -->
  <RECEIVE>
    <XML>
      <ELEMENT Tag="Cmd/Move"        Type="STRING" Set_Flag="990" />
      <ELEMENT Tag="Cmd/MoveJ"       Type="STRING" Set_Flag="991" />
      <ELEMENT Tag="Cmd/Stop"        Type="STRING" Set_Flag="992" />
      <ELEMENT Tag="Cmd/Home"        Type="STRING" Set_Flag="993" />
      <ELEMENT Tag="Cmd/FkRequest"   Type="STRING" Set_Flag="994" />
      <ELEMENT Tag="Cmd/IkRequest"   Type="STRING" Set_Flag="995" />
      <ELEMENT Tag="Cmd/Echo"        Type="STRING" Set_Flag="996" />
    </XML>
  </RECEIVE>

  <!--
    Send (KRL → Willy):
      Every send call wraps the payload in <Sen Type="Willy">. The
      KRL program is responsible for appending '\n' after the closing
      </Sen>. See Willy.src for the helper procedures.
  -->
  <SEND>
    <XML>
      <ELEMENT Tag="Sen"             Type="STRING" />
    </XML>
  </SEND>
</ETHERNETKRLXML>
